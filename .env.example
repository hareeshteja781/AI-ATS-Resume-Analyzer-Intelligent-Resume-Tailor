# Shared local/dev environment placeholders. Do not commit real values.
# Copy to .env and populate locally before running Docker Compose.

POSTGRES_DB=resume_ats
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=change_me

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=resume_ats
DATABASE_USER=resume_app
DATABASE_PASSWORD=change_me

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

R2_ENDPOINT_URL=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=resume-ats-prod
R2_PUBLIC_URL=https://example.r2.dev

VITE_API_URL=http://localhost:8000/api/v1
